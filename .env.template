# Menditect Agentic Test Workspace - Environment Configuration
# This file stores environment secrets and local overrides. Run "npm run setup" to configure interactively.

# 1. MTA Primitive Tools MCP Endpoint (MTA Cloud / Server MCP gateway)
# Default for trial: https://mta-trial.mendixcloud.com/primitivetools/mcp
MTA_MCP_ENDPOINT="https://mta-trial.mendixcloud.com/primitivetools/mcp"

# 2. MTA Service Account Identification Token (Optional / Cloud Authoring License)
# In MTA Portal: Service Account Overview -> Create Service Account -> Enable "Call MCP primitive tools"
# Format: Bearer menditect_mta_identification_token<token_key> (no space between prefix and token key)
# Leave empty if using free exploratory testing without an MTA server license.
# Example: MTA_MCP_AUTH_HEADER="Bearer menditect_mta_identification_tokenHCdcC0Nt2uRo4rPHGVnwX0zJLRHgcBnUF81XhI0XCOhj"
MTA_MCP_AUTH_HEADER=""

# 3. Running App Under Test Plugin MCP URL (Local Exploratory Testing)
# MCP endpoint provided by MtaPluginModule in your running local Mendix application.
PLUGIN_MCP_URL="http://localhost:8081/plugin/mcp"

# 4. App Under Test Plugin Security Token
# Protects the MtaPluginModule MCP endpoint in your running app.
# Configured in Studio Pro via constant MtaPluginModule.McpServerAccessToken.
PLUGIN_MCP_TOKEN="Bearer 1"

# 5. Local Mendix Project Paths (Auto-configured by npm run setup)
MENDIX_PROJECT_DIR=""
MENDIX_MPR_PATH=""
